{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Doc2EPUB",
  "mainBinaryName": "Doc2EPUB",
  "version": "1.0.0",
  "identifier": "com.teakay.doc2epub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Doc2EPUB",
        "width": 1060,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob: ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
